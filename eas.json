{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "credentialsSource": "remote",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1",
        "config": "build-ios.yml"
      }
    },
    "internal": {
      "extends": "production",
      "env": {
        "TAKEN_INTERNAL_PRO": "1"
      },
      "ios": {
        "config": "build-ios-internal.yml"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6822086891",
        "appleTeamId": "F7YRP3B2U8"
      }
    },
    "internal": {
      "ios": {
        "ascAppId": "6822086891",
        "appleTeamId": "F7YRP3B2U8"
      }
    }
  }
}
