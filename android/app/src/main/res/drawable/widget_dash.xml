<?xml version="1.0" encoding="utf-8"?>
<!-- The dashed hairline between the stack widget's rows (3 on, 3 off), white for the widget to tint. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="line">
    <stroke
        android:width="1dp"
        android:color="#FFFFFFFF"
        android:dashGap="3dp"
        android:dashWidth="3dp" />
</shape>
