<?xml version="1.0" encoding="utf-8"?>
<!-- Taken's launcher icon, background layer: Signal's canvas with the iPhone icon's lift at the centre.
     Drawn by the Android part of brand/icon.py from the iPhone icon's geometry: change icon.py, never this
     file, and run it again. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1536"
    android:viewportHeight="1536">
    <path
        android:pathData="M0,0 H1536 V1536 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="768" android:centerY="768"
                android:gradientRadius="640">
                <item android:offset="0" android:color="#0F1012" />
                <item android:offset="0.2" android:color="#0E0F11" />
                <item android:offset="0.4" android:color="#0D0E0F" />
                <item android:offset="0.6" android:color="#0A0B0D" />
                <item android:offset="0.8" android:color="#090A0B" />
                <item android:offset="1" android:color="#08090A" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
