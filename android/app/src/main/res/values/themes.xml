<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window before Compose draws: Signal's dark canvas, so a cold launch never flashes white. Everything else is
         Compose, themed from Taken's look tokens (ui/theme/TakenTheme.kt). -->
    <style name="Theme.Taken" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launch_canvas</item>
    </style>

    <!-- The splash screen (SPEC-ANDROID 6.1), MainActivity's theme until Taken has read its files: the default look's
         canvas, #08090A as the iPhone's launch screen, with the icon's capsule, on every API level through
         core-splashscreen (https://developer.android.com/develop/ui/views/launch/splash-screen/migrate). Light system bar
         icons over the dark canvas whatever the system's own setting: the library's day theme asks for a light
         navigation bar from Android 13. -->
    <style name="Theme.Taken.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/launch_canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Taken</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
