<?xml version="1.0" encoding="utf-8"?>
<!-- Taken's launcher icon (SPEC-ANDROID 17, NEXT 7): the iPhone's Signal icon as an adaptive icon, one icon for every look
     (SPEC-ANDROID 19 item 5). Three vector layers drawn by brand/icon.py from the iPhone icon's geometry: the canvas, the
     brackets and capsule, and the monochrome layer that Android 13 and later tint when the person turns on themed icons
     (https://developer.android.com/develop/ui/views/launch/icon_design_adaptive). minSdk 28 has adaptive icons
     everywhere, so there is no bitmap fallback and no round icon. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
