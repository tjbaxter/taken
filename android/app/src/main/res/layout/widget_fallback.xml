<?xml version="1.0" encoding="utf-8"?>
<!-- A Taken widget Android could not draw (WidgetFallback, SPEC-ANDROID 10.1): the mark, TAKEN and a line saying what a
     tap does, in the person's look, which WidgetFallback sets on these views. Text and two vector marks, no bitmaps, as
     Google asks of the fallback from Android 17 (https://developer.android.com/develop/ui/compose/glance/error-handling).
     The text keeps the widgets' fixed sizes: a widget's cells do not grow with the text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="12dp"
    tools:ignore="SpUsage">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:importantForAccessibility="no">

            <ImageView
                android:id="@+id/widget_fallback_lit"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_capsule_lit" />

            <ImageView
                android:id="@+id/widget_fallback_outline"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_capsule_outline" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_fallback_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="monospace"
            android:importantForAccessibility="no"
            android:letterSpacing="0.24"
            android:maxLines="1"
            android:textSize="10dp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_fallback_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:importantForAccessibility="no"
        android:maxLines="2"
        android:textSize="15dp" />
</LinearLayout>
